# Copy to .env and fill in. Never commit .env.

# Where you are (defaults to your coordinates)
HOME_LAT=30.427749633789062
HOME_LON=-97.72123718261719
RADIUS_MI=20
TIMEZONE=America/Chicago

# Flights: OpenSky API client credentials (free account, then create an API client)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# opensky or adsblol (the other one is used as automatic fallback)
FLIGHT_SOURCE=opensky
# Seconds between position polls. Keep at 30 or more on the free OpenSky tier.
POLL_SECONDS=30

# Calendar: Google Calendar > Settings > your calendar > "Secret address in iCal format"
ICAL_URL=
# Optional: extra addresses or aliases (comma-separated) used to hide events you declined.
# Your main address is read from ICAL_URL automatically.
CALENDAR_EMAILS=

# Stocks: free key from finnhub.io (use ETFs like SPY, QQQ; indexes need a paid plan)
FINNHUB_KEY=
STOCK_SYMBOLS=SPY,QQQ,DIA,AAPL,MSFT,NVDA

# Reload the kiosk page automatically when files under static/ change or the server restarts
AUTO_RELOAD=true
